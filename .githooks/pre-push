#!/bin/sh
# PHONE GAT — שער לפרודקשן.
#
# מופעל אוטומטית בכל `git push`. חוסם דחיפה ל-main אלא אם כן:
#   1. בדיקות טרום-ההעלאה עוברות.
#   2. בדיוק הקומיט הזה כבר נפרס לסביבת הבדיקות (קיים ב-origin/staging).
#
# תנאי 2 הוא הלב: הוא הופך "קודם טסטים" מהמלצה למשהו שאי אפשר לדלג עליו
# בשוגג. אם לא ראית את הקוד הזה רץ ב-staging — הוא לא יעלה לאתר החי.
#
# דחיפות לענפים אחרים (כולל staging) עוברות בלי הפרעה.
#
# הפעלה חד-פעמית: git config core.hooksPath .githooks
# מעקף לחירום:    PG_FORCE=1 git push origin main

REMOTE_NAME="$1"
BLOCKED=0

while read local_ref local_sha remote_ref remote_sha; do
  # רק דחיפה ל-main מעניינת אותנו
  case "$remote_ref" in
    refs/heads/main) ;;
    *) continue ;;
  esac

  # מחיקת ענף — לא נוגעים
  case "$local_sha" in
    *[^0]*) ;;
    *) continue ;;
  esac

  if [ "$PG_FORCE" = "1" ]; then
    echo "⚠  PG_FORCE=1 — עוקפים את שער הפרודקשן. שיהיה בהצלחה."
    continue
  fi

  echo ""
  echo "── שער פרודקשן ─────────────────────────────"

  # 0. מה שנבדק הוא מה שנדחף
  #
  # preflight.js קורא מהדיסק ולא מהקומיט: אפס קריאות לגיט בכל הקובץ, מול קריאות readFileSync.
  # ship.js מסנן קבצים לא-עקובים בכוונה, והשער הזה לא קרא לו בכלל. שלוש החוליות יחד אמרו
  # שאפשר לעבור את השער עם דיסק תקין וקומיט חסר, וזה בדיוק מה שהצעד המתועד ב-CLAUDE.md
  # מייצר: git commit -am מקמט שינויים לקבצים עקובים בלבד, ולכן עמוד חדש שמחולל יצר נשאר
  # מחוץ לקומיט בזמן ש-sw.js, הניווט וה-hub כבר מצביעים אליו. הפריפלייט עובר כי הקובץ על
  # הדיסק, השרת המקומי מגיש אותו מאותה סיבה, ובפרודקשן זה 404 שמקושר מכל מקום.
  #
  # רק prototype/ נבדק כאן: שינוי בהנחיות או בסקריפטים אינו נפרס, ולפעמים הוא של סשן אחר
  # שחולק את התיקייה, ואין סיבה שיחסום העלאה.
  DIRTY=$(git status --porcelain -- prototype/ 2>/dev/null)
  if [ -n "$DIRTY" ]; then
    echo "✗ יש שינויים ב-prototype/ שאינם בקומיט הזה:"
    echo "$DIRTY" | sed 's/^/    /'
    echo ""
    echo "  הפריפלייט בודק את הדיסק, ולכן הוא היה עובר גם אם הקומיט חסר את השינויים האלה."
    echo "  קמט אותם, או נקה אותם, ואז: node .claude/ship.js stage"
    BLOCKED=1
    continue
  fi

  # 1. בדיקות
  if ! node .claude/preflight.js; then
    echo "✗ הבדיקות נכשלו. תקן, ואז שוב: node .claude/ship.js stage"
    BLOCKED=1
    continue
  fi

  # 2. האם הקומיט הזה עבר דרך סביבת בדיקות כלשהי?
  # לכל סשן יש ענף משלו, staging-<שם>, כדי שארבעה סשנים שחולקים את התיקייה
  # לא ידרכו זה על זה. מספיק שהקומיט נמצא באחד מהם. `staging` היחיד והישן
  # עדיין תקף, כדי שלא נשבור clone שטרם עודכן.
  git fetch -q --prune "$REMOTE_NAME" 2>/dev/null

  STAGED_ON=""
  for ref in $(git for-each-ref --format='%(refname:short)' \
                 "refs/remotes/$REMOTE_NAME/staging" \
                 "refs/remotes/$REMOTE_NAME/staging-*"); do
    if git merge-base --is-ancestor "$local_sha" "$ref" 2>/dev/null; then
      STAGED_ON="$ref"
      break
    fi
  done

  if [ -z "$STAGED_ON" ]; then
    short=$(git rev-parse --short "$local_sha")
    echo "✗ הקומיט $short לא נפרס לאף סביבת בדיקות, ולכן לא ראית אותו עובד."
    echo ""
    echo "  מה לעשות:"
    echo "    node .claude/ship.js stage     # מעלה לבדיקות ומדפיס את הכתובת"
    echo "    (בודקים בדפדפן, גם בטלפון)"
    echo "    node .claude/ship.js prod      # ואז לאתר החי"
    echo ""
    echo "  אם זה תיקון חירום שחייב לעלות עכשיו:"
    echo "    PG_FORCE=1 git push origin main"
    BLOCKED=1
    continue
  fi

  echo "✓ הבדיקות עוברות והקוד נבדק ב-${STAGED_ON#$REMOTE_NAME/} — ממשיכים לאתר החי."
  echo "────────────────────────────────────────────"
done

exit $BLOCKED
